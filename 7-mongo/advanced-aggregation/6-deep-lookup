db.students.aggregate([
  {
    $lookup: {
      from: 'enrollments',
      let: { studentId: '$_id' },
      pipeline: [
        {
          $match: {
            $expr: {
              $eq: ['$studentId', '$$studentId']
            }
          }
        },
        {
          $lookup: {
            from: 'classes',
            let: { classId: '$classId' },
            pipeline: [
              {
                $match: {
                  $expr: {
                    $eq: ['$_id', '$$classId']
                  }
                }
              },
              {
                $lookup: {
                  from: 'teachers',
                  let: { teacherId: '$teacherId' },
                  pipeline: [
                    {
                      $match: {
                        $expr: {
                          $eq: ['$_id', '$$teacherId']
                        }
                      }
                    },
                    {
                      $project: {
                        _id: 0,
                        name: 1,
                        department: 1
                      }
                    }
                  ],
                  as: 'teacher'
                }
              },
              {
                $unwind: '$teacher'
              }
            ],
            as: 'class'
          }
        },
        {
          $unwind: '$class'
        }
      ],
      as: 'classes'
    }
  }
])