db.students.aggregate([
  {
    $lookup: {
      from: 'classes',
      let: {
        studentYear: '$year'
      },
      pipeline: [
        {
          $match: {
            $expr: {
              $eq: ['$year', '$$studentYear']
            }
          }
        },
        {
          $project: {
            title: 1,
            year: 1,
            teacherId: 1
          }
        }
      ],
      as: 'availableClassesForYear'
    }
  }
])